#!/usr/bin/env python3
"""status-dashboard — the in-harness orchestration UI.

Renders work completed / in progress / todo from the project's tracking board,
so an orchestrator (AVRIL, AXEL, or a generated orchestrator prompt) can refresh
a single view as it makes progress. A view, never a record.

Usage:
    scripts/status-dashboard                 # terminal summary
    scripts/status-dashboard --html          # also write docs/status-dashboard.html
    scripts/status-dashboard --html-only     # write the HTML, print nothing
    scripts/status-dashboard --out PATH      # HTML destination
    scripts/status-dashboard --root DIR      # project root (default: repo root)
    scripts/status-dashboard --config PATH   # tracker config (default: dashboard.config.json)
    scripts/status-dashboard --markdown      # markdown, for pasting into chat
    scripts/status-dashboard --detail        # deep view of one project
    scripts/status-dashboard --root A --root B ...   # portfolio across projects

The board is the source. There is no file-based tracker to fall back to: a board
that cannot be read is reported as unread, never filled in with a guess. Recent
commits ride along as context, not as work state.

The harness requires a board and names none. `board.backend` picks the adapter
(see BOARD_ADAPTERS below); `auto` probes the known ones and reports the absence
when none is available. A project whose tracker uses different status words or a
different CLI supplies `dashboard.config.json` (see DEFAULT_CONFIG). The payload
every backend must emit is docs/board-contract.md.

A board command is run as an argv list, never through a shell, so a config cannot
inject shell syntax — but it does name a program this script will execute, so
treat it with the same trust as a justfile.

Structure follows the repo's own philosophy: reading sources are actions,
everything that shapes or renders the model is a pure calculation.
"""

from __future__ import annotations

import argparse
import datetime as _datetime
import html
import json
import os
import re
import shutil
import subprocess
import sys
from pathlib import Path

DONE = "done"
ACTIVE = "active"
TODO = "todo"

DEFAULT_CONFIG = {
    # Status vocabularies. Anything unmatched is todo, so only done and active
    # need listing. Compared case-insensitively with -/_/space normalised.
    # The canonical lifecycle types (completed / started) are listed alongside the
    # human words so a board that renames its columns still classifies correctly.
    "status_map": {
        "done": ["completed", "complete", "done", "verified", "merged", "shipped"],
        "active": ["started", "in progress", "inprogress", "building", "built",
                   "review", "in review", "in_review", "wip", "regressed"],
    },
    # Board source. `backend` names an adapter in BOARD_ADAPTERS, or "command"
    # to run `command` (an argv list, without a shell), or "none".
    # `items_path` walks into the payload; "" means the payload is the list.
    # `fields` maps this contract's names onto the tracker's own key names.
    "board": {
        "backend": "auto",
        "file": "board.json",
        "command": [],
        "items_path": "",
        "fields": {"id": "id", "title": "title", "status": "status",
                   "status_label": "status", "group": "group", "url": "url"},
    },
}

# Board adapters, probed in this order when `backend` is "auto". Each names how
# to reach a board and how to read what comes back; none of them is a default in
# the sense of being preferred — the first one a project can actually run wins.
BOARD_ADAPTERS = {
    "linear": {
        "script": "linear-board",
        "env_any": ["LINEAR_API_KEY", "LINEAR_TOKEN"],
        "items_path": "tasks",
        "fields": {"id": "id", "title": "title", "status": "status_type",
                   "status_label": "status", "group": "group", "url": "url"},
    },
    "file": {
        "file": "board.json",
        "items_path": "tasks",
        "fields": {"id": "id", "title": "title", "status": "status_type",
                   "status_label": "status", "group": "group", "url": "url"},
    },
}


def normalise(word: str) -> str:
    """Fold -, _ and whitespace so 'in-progress' == 'in_progress' == 'In Progress'."""
    return re.sub(r"[\s_-]+", " ", (word or "").strip().lower())


def load_config(root: Path, path: str | None) -> dict:
    """Merge a project config over the defaults. A broken config is reported, not swallowed."""
    candidate = Path(path) if path else (root / "dashboard.config.json")
    if not candidate.is_absolute():
        candidate = root / candidate
    if not candidate.exists():
        return DEFAULT_CONFIG
    raw = json.loads(candidate.read_text())
    cfg = {**DEFAULT_CONFIG, **raw}
    cfg["status_map"] = {**DEFAULT_CONFIG["status_map"], **raw.get("status_map", {})}
    cfg["board"] = merge_board(DEFAULT_CONFIG["board"], raw.get("board", {}))
    # Kept verbatim so an adapter can slot in underneath the project's own
    # overrides: defaults < adapter < what this file actually said.
    cfg["board_overrides"] = raw.get("board", {})
    return cfg


def merge_board(base: dict, *layers: dict) -> dict:
    """Layer board configs, newest last, merging `fields` instead of replacing it."""
    out = dict(base)
    out["fields"] = dict(base.get("fields", {}))
    for layer in layers:
        out.update({k: v for k, v in layer.items() if k != "fields"})
        out["fields"] = {**out["fields"], **(layer.get("fields") or {})}
    return out


# ---------------------------------------------------------------- calculations

def classify(status: str, status_map: dict | None = None) -> str:
    """Map a tracker's status vocabulary onto done / active / todo."""
    m = status_map or DEFAULT_CONFIG["status_map"]
    s = normalise(status)
    if s in {normalise(w) for w in m.get("done", [])}:
        return DONE
    if s in {normalise(w) for w in m.get("active", [])}:
        return ACTIVE
    return TODO


def groups_from_board(board: list[dict]) -> list[dict]:
    """Group board items by workstream, unfinished groups first.

    A group is whatever the board calls a container — a Linear project, an
    epic, a milestone. Items without one collect under "ungrouped" rather
    than disappearing from the view.
    """
    order: list[str] = []
    buckets: dict[str, list[dict]] = {}
    for item in board:
        name = item.get("group") or "ungrouped"
        if name not in buckets:
            buckets[name] = []
            order.append(name)
        buckets[name].append(item)

    groups = []
    for name in order:
        items = buckets[name]
        done = sum(1 for i in items if i["state"] == DONE)
        active = any(i["state"] == ACTIVE for i in items)
        groups.append({
            "name": name,
            "state": DONE if done == len(items) else (ACTIVE if active else TODO),
            "items": items,
            "done": done,
            "total": len(items),
            "percent": round(100 * done / len(items)) if items else 0,
        })
    groups.sort(key=lambda g: ({DONE: 2, ACTIVE: 0, TODO: 1}[g["state"]], g["name"]))
    return groups


def dig(node: object, path: str) -> object:
    """Follow a dotted key path. Trackers nest (GitHub Projects puts title under content)."""
    for key in [k for k in (path or "").split(".") if k]:
        if not isinstance(node, dict):
            return None
        node = node.get(key)
    return node


def board_items(raw: object, board_cfg: dict | None = None,
                status_map: dict | None = None) -> list[dict]:
    """Shape any board payload into items, per the config's path and field names."""
    cfg = board_cfg or DEFAULT_CONFIG["board"]
    node = dig(raw, cfg.get("items_path") or "") if cfg.get("items_path") else None
    if node is None:
        node = raw if isinstance(raw, list) else (raw or {}).get("tasks", [])
    d = DEFAULT_CONFIG["board"]["fields"]
    f = {**d, **cfg.get("fields", {})}
    return [
        {
            "id": dig(t, f["id"]) or "?",
            "title": dig(t, f["title"]) or "",
            "state": classify(dig(t, f["status"]) or "", status_map),
            "status": dig(t, f["status_label"]) or dig(t, f["status"]) or "",
            "group": dig(t, f["group"]) or "",
            "url": dig(t, f["url"]) or "",
        }
        for t in node if isinstance(t, dict)
    ]


def totals(board: list[dict], backend: str | None = None) -> dict:
    """Count units of work by state. The board is the only source there is."""
    return {
        DONE: sum(1 for u in board if u["state"] == DONE),
        ACTIVE: sum(1 for u in board if u["state"] == ACTIVE),
        TODO: sum(1 for u in board if u["state"] == TODO),
        "source": backend or "none",
    }


def build_model(board_raw: object, backend: str | None, commits: list[str],
                project: str, generated: str, config: dict | None = None) -> dict:
    cfg = config or DEFAULT_CONFIG
    sm = cfg.get("status_map")
    board = board_items(board_raw, cfg.get("board"), sm)
    raw_items = board_raw if isinstance(board_raw, list) else (board_raw or {}).get("tasks", [])
    if not isinstance(raw_items, list):
        raw_items = []
    return {
        "project": project,
        "generated": generated,
        "backend": backend,
        "groups": groups_from_board(board),
        "board": board,
        "raw_items": raw_items,
        "totals": totals(board, backend),
        "commits": commits,
    }


def readiness(board: list[dict], raw_items: list[dict]) -> dict:
    """Split open items into ready and blocked using depends_on.

    "10 todo" is misleading when 8 of them are waiting on each other. Ready means
    every dependency is done, so it is the only number that answers "what can I
    start right now".
    """
    by_id = {str(r.get("id")): r for r in raw_items if isinstance(r, dict)}
    done_ids = {i["id"] for i in board if i["state"] == DONE}
    ready, blocked = [], []
    for item in board:
        if item["state"] == DONE:
            continue
        deps = (by_id.get(str(item["id"]), {}) or {}).get("depends_on") or []
        missing = [d for d in deps if d not in done_ids]
        (blocked if missing else ready).append({**item, "waiting_on": missing})
    return {"ready": ready, "blocked": blocked}


def label_counts(raw_items: list[dict], board: list[dict]) -> list[tuple]:
    """Open-item counts per label, most common first."""
    open_ids = {str(i["id"]) for i in board if i["state"] != DONE}
    counts = {}
    for r in raw_items:
        if isinstance(r, dict) and str(r.get("id")) in open_ids:
            for lab in (r.get("labels") or []):
                counts[lab] = counts.get(lab, 0) + 1
    return sorted(counts.items(), key=lambda kv: (-kv[1], kv[0]))


def open_groups(groups: list[dict]) -> list[dict]:
    """Groups with unfinished work, and the items still outstanding in them."""
    return [
        {"name": g["name"], "done": g["done"], "total": g["total"],
         "items": [i for i in g["items"] if i["state"] != DONE]}
        for g in groups if g["state"] != DONE
    ]


# ------------------------------------------------------------------- rendering

MARK = {DONE: "✔", ACTIVE: "▶", TODO: "○"}
LABEL = {DONE: "completed", ACTIVE: "in progress", TODO: "todo"}


def render_terminal(model: dict) -> str:
    t = model["totals"]
    out = [
        "",
        f"  {model['project']} — orchestration status",
        f"  {model['generated']}",
        "",
        f"  {MARK[DONE]} completed {t[DONE]:>3}"
        f"    {MARK[ACTIVE]} in progress {t[ACTIVE]:>3}"
        f"    {MARK[TODO]} todo {t[TODO]:>3}"
        f"    (board: {t['source']})",
    ]

    if model["groups"]:
        out += ["", "  WORKSTREAMS"]
        open_by_name = {og["name"]: og["items"] for og in open_groups(model["groups"])}
        for p in model["groups"]:
            bar_len = 16
            filled = round(bar_len * p["percent"] / 100)
            bar = "█" * filled + "·" * (bar_len - filled)
            out.append(f"    {MARK[p['state']]} {p['name'][:34]:<34} "
                       f"{bar} {p['done']}/{p['total']}")
            for i in open_by_name.get(p["name"], []):
                out.append(f"        {MARK[i['state']]} {i['id']}  {i['title'][:52]}")

    open_items = [b for b in model["board"] if b["state"] != DONE]
    if open_items:
        out += ["", f"  BOARD ({len(open_items)} open)"]
        for b in open_items:
            out.append(f"    {MARK[b['state']]} {b['id']:<6} {b['title'][:56]}")

    if not model["board"]:
        out += ["", "  no board read — disclose one in dashboard.config.json",
                "  (docs/board-contract.md)"]

    if model["commits"]:
        out += ["", "  RECENT COMMITS",
                *(f"    {line}" for line in model["commits"][:3])]

    out.append("")
    return "\n".join(out)


def render_detail_markdown(model: dict, detail: dict) -> str:
    """A deep view of one project, for a chat surface."""
    t = model["totals"]
    r, b = detail["ready"], detail["blocked"]
    out = [
        f"## {model['project']} — detailed status  ",
        f"`{model['generated']}` · source: {t['source']}",
        "",
        "| ✅ completed | 🟡 in progress | ⬜ todo | ▶️ startable now |",
        "|---:|---:|---:|---:|",
        f"| {t[DONE]} | {t[ACTIVE]} | {t[TODO]} | **{len(r)}** |",
    ]
    if b:
        out += ["", f"_{len(r)} of {len(r) + len(b)} open items can be started; "
                    f"{len(b)} are waiting on something._"]

    if r:
        out += ["", "### Ready to start", "", "| | id | title |", "|---|---|---|"]
        for i in r:
            out.append(f"| {'🟡' if i['state'] == ACTIVE else '⬜'} | `{i['id']}` | {i['title']} |")
    if b:
        out += ["", "### Blocked", "", "| id | waiting on | title |", "|---|---|---|"]
        for i in b:
            out.append(f"| `{i['id']}` | {', '.join(f'`{w}`' for w in i['waiting_on']) or '—'} | {i['title']} |")

    if detail["labels"]:
        out += ["", "### Open work by label", "",
                " · ".join(f"**{k}** {v}" for k, v in detail["labels"][:8])]

    if detail["groups"]:
        out += ["", "### Unfinished workstreams"]
        for p in detail["groups"]:
            out += ["", f"**{p['name']}** — {p['done']}/{p['total']}"]
            for i in p["items"]:
                out.append(f"- {'🟡' if i['state'] == ACTIVE else '⬜'} `{i['id']}` {i['title']}")

    if detail.get("commits"):
        out += ["", "### Recent commits", "", "```", *detail["commits"], "```"]

    return "\n".join(out)


def render_detail_terminal(model: dict, detail: dict) -> str:
    t = model["totals"]
    r, b = detail["ready"], detail["blocked"]
    out = ["", f"  {model['project']} — detailed status", f"  {model['generated']}", "",
           f"  {MARK[DONE]} completed {t[DONE]:>3}    {MARK[ACTIVE]} in progress {t[ACTIVE]:>3}"
           f"    {MARK[TODO]} todo {t[TODO]:>3}    ▶ startable now {len(r)}"]
    if r:
        out += ["", "  READY TO START"]
        out += [f"    {MARK[i['state']]} {str(i['id']):<7}{i['title'][:56]}" for i in r]
    if b:
        out += ["", "  BLOCKED"]
        out += [f"    {MARK[i['state']]} {str(i['id']):<7}waits on {','.join(i['waiting_on']):<12} {i['title'][:36]}" for i in b]
    if detail["labels"]:
        out += ["", "  BY LABEL", "    " + "  ".join(f"{k}={v}" for k, v in detail["labels"][:8])]
    if detail.get("commits"):
        out += ["", "  RECENT COMMITS", *(f"    {c}" for c in detail["commits"])]
    out.append("")
    return "\n".join(out)


def _cards(items: list[dict], state: str) -> str:
    tone = {
        DONE: ("emerald", "fa-check"),
        ACTIVE: ("amber", "fa-play"),
        TODO: ("zinc", "fa-circle"),
    }[state]
    if not items:
        return '<div class="text-sm text-zinc-600 italic px-1 py-3">nothing here</div>'
    return "".join(
        f'<div class="bg-zinc-900 border border-zinc-800 rounded-2xl px-4 py-3">'
        f'<div class="flex items-center gap-2">'
        f'<i class="fa-solid {tone[1]} text-{tone[0]}-400 text-xs"></i>'
        f'<span class="font-mono text-xs text-zinc-500">{html.escape(str(i["id"]))}</span>'
        f'</div>'
        f'<div class="text-sm text-zinc-200 mt-1 leading-snug">{html.escape(i["title"])}</div>'
        f'</div>'
        for i in items
    )


def render_html(model: dict) -> str:
    t = model["totals"]
    units = model["board"]
    by = {s: [u for u in units if u["state"] == s] for s in (DONE, ACTIVE, TODO)}
    total = max(len(units), 1)

    group_rows = "".join(
        f'<div class="py-3 border-b border-zinc-800/60 last:border-0">'
        f'<div class="flex items-center justify-between gap-4">'
        f'<div class="flex items-center gap-2 min-w-0">'
        f'<i class="fa-solid {"fa-check text-emerald-400" if p["state"] == DONE else ("fa-play text-amber-400" if p["state"] == ACTIVE else "fa-circle text-zinc-600")} text-xs"></i>'
        f'<span class="text-sm text-zinc-200 truncate">{html.escape(p["name"])}</span>'
        f'</div>'
        f'<span class="text-xs text-zinc-500 tabular-nums shrink-0">{p["done"]}/{p["total"]}</span>'
        f'</div>'
        f'<div class="h-1.5 bg-zinc-800 rounded-full mt-2 overflow-hidden">'
        f'<div class="h-full rounded-full {"bg-emerald-500" if p["state"] == DONE else "bg-amber-500"}" style="width:{p["percent"]}%"></div>'
        f'</div></div>'
        for p in model["groups"]
    ) or '<div class="text-sm text-zinc-600 italic">no workstreams on the board</div>'

    def pct(n): return round(100 * n / total)

    return f"""<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>{html.escape(model['project'])} — orchestration status</title>
<script src="https://cdn.tailwindcss.com"></script>
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">
</head>
<body class="bg-zinc-950 text-zinc-200 antialiased">
<div class="max-w-6xl mx-auto px-6 py-12">

  <div class="flex items-end justify-between flex-wrap gap-4 mb-10">
    <div>
      <div class="text-3xl font-semibold tracking-tighter">{html.escape(model['project'])}</div>
      <div class="text-sm text-zinc-500 mt-1">Orchestration status · board: {html.escape(t['source'])}</div>
    </div>
    <div class="text-xs text-zinc-600 font-mono">{html.escape(model['generated'])}</div>
  </div>

  <div class="grid grid-cols-3 gap-4 mb-8">
    <div class="bg-zinc-900 border border-zinc-800 rounded-3xl p-5">
      <div class="text-4xl font-semibold text-emerald-400 tabular-nums">{t[DONE]}</div>
      <div class="text-sm text-zinc-400 mt-1">completed</div>
    </div>
    <div class="bg-zinc-900 border border-zinc-800 rounded-3xl p-5">
      <div class="text-4xl font-semibold text-amber-400 tabular-nums">{t[ACTIVE]}</div>
      <div class="text-sm text-zinc-400 mt-1">in progress</div>
    </div>
    <div class="bg-zinc-900 border border-zinc-800 rounded-3xl p-5">
      <div class="text-4xl font-semibold text-zinc-400 tabular-nums">{t[TODO]}</div>
      <div class="text-sm text-zinc-400 mt-1">todo</div>
    </div>
  </div>

  <div class="flex h-2 rounded-full overflow-hidden mb-10 bg-zinc-800">
    <div class="bg-emerald-500" style="width:{pct(len(by[DONE]))}%"></div>
    <div class="bg-amber-500" style="width:{pct(len(by[ACTIVE]))}%"></div>
  </div>

  <div class="grid grid-cols-1 md:grid-cols-3 gap-5 mb-10">
    <div>
      <div class="text-xs uppercase tracking-widest text-emerald-400/80 mb-3">Completed · {len(by[DONE])}</div>
      <div class="space-y-2">{_cards(by[DONE], DONE)}</div>
    </div>
    <div>
      <div class="text-xs uppercase tracking-widest text-amber-400/80 mb-3">In progress · {len(by[ACTIVE])}</div>
      <div class="space-y-2">{_cards(by[ACTIVE], ACTIVE)}</div>
    </div>
    <div>
      <div class="text-xs uppercase tracking-widest text-zinc-500 mb-3">Todo · {len(by[TODO])}</div>
      <div class="space-y-2">{_cards(by[TODO], TODO)}</div>
    </div>
  </div>

  <div class="bg-zinc-900/60 border border-zinc-800 rounded-3xl p-6 mb-6">
    <div class="text-xs uppercase tracking-widest text-zinc-500 mb-3">Workstreams</div>
    {group_rows}
  </div>

  <div class="bg-zinc-900/60 border border-zinc-800 rounded-3xl p-6">
    <div class="text-xs uppercase tracking-widest text-zinc-500 mb-3">Recent commits</div>
    <pre class="text-xs text-zinc-400 whitespace-pre-wrap font-mono leading-relaxed">{html.escape(chr(10).join(model['commits']) or '(no git history)')}</pre>
  </div>

  <div class="text-xs text-zinc-700 mt-8">
    Regenerate with <span class="font-mono text-zinc-500">just status-html</span>. This file is generated — do not edit by hand.
  </div>

</div>
</body>
</html>
"""


def _bar(percent: int, width: int = 10) -> str:
    filled = round(width * percent / 100)
    return "█" * filled + "░" * (width - filled)


def render_markdown(model: dict) -> str:
    """One project, as markdown a chat client will render."""
    t = model["totals"]
    out = [
        f"**{model['project']}** — orchestration status  ",
        f"`{model['generated']}` · source: {t['source']}",
        "",
        f"| ✅ completed | 🟡 in progress | ⬜ todo |",
        f"|---:|---:|---:|",
        f"| {t[DONE]} | {t[ACTIVE]} | {t[TODO]} |",
    ]
    if model["groups"]:
        out += ["", "| workstream | progress | |", "|---|---|---:|"]
        for p in model["groups"]:
            out.append(f"| {p['name']} | `{_bar(p['percent'])}` | {p['done']}/{p['total']} |")
    open_items = [b for b in model["board"] if b["state"] != DONE]
    if open_items:
        out += ["", f"**Open board items ({len(open_items)})**", "", "| | id | title |", "|---|---|---|"]
        for b in open_items[:15]:
            out.append(f"| {'🟡' if b['state'] == ACTIVE else '⬜'} | `{b['id']}` | {b['title']} |")
        if len(open_items) > 15:
            out.append(f"| | | _+{len(open_items) - 15} more_ |")
    return "\n".join(out)


def build_portfolio(models: list[dict], generated: str) -> dict:
    """Aggregate several project models. Pure: no reading, no formatting."""
    agg = {DONE: 0, ACTIVE: 0, TODO: 0}
    for m in models:
        for k in (DONE, ACTIVE, TODO):
            agg[k] += m["totals"][k]
    return {"projects": models, "totals": agg, "generated": generated,
            "count": len(models)}


def render_portfolio_markdown(pf: dict) -> str:
    a = pf["totals"]
    total = max(a[DONE] + a[ACTIVE] + a[TODO], 1)
    out = [
        f"## Portfolio status — {pf['count']} projects  ",
        f"`{pf['generated']}`",
        "",
        "| ✅ completed | 🟡 in progress | ⬜ todo | done |",
        "|---:|---:|---:|---:|",
        f"| {a[DONE]} | {a[ACTIVE]} | {a[TODO]} | {round(100 * a[DONE] / total)}% |",
        "",
        "| project | ✅ | 🟡 | ⬜ | progress | source |",
        "|---|---:|---:|---:|---|---|",
    ]
    for m in pf["projects"]:
        t = m["totals"]
        n = max(t[DONE] + t[ACTIVE] + t[TODO], 1)
        out.append(f"| **{m['project']}** | {t[DONE]} | {t[ACTIVE]} | {t[TODO]} | "
                   f"`{_bar(round(100 * t[DONE] / n))}` | {t['source']} |")
    active = [(m["project"], u) for m in pf["projects"]
              for u in m["board"] if u["state"] == ACTIVE]
    if active:
        out += ["", "**In progress right now**", "", "| project | id | title |", "|---|---|---|"]
        for proj, item in active:
            out.append(f"| {proj} | `{item['id']}` | {item['title']} |")
    return "\n".join(out)


def render_portfolio_html(pf: dict) -> str:
    a = pf["totals"]
    total = max(a[DONE] + a[ACTIVE] + a[TODO], 1)
    rows = ""
    for m in pf["projects"]:
        t = m["totals"]
        n = max(t[DONE] + t[ACTIVE] + t[TODO], 1)
        pct = round(100 * t[DONE] / n)
        rows += (
            f'<div class="bg-zinc-900 border border-zinc-800 rounded-3xl p-5">'
            f'<div class="flex items-baseline justify-between gap-3">'
            f'<div class="font-semibold text-zinc-100 truncate">{html.escape(m["project"])}</div>'
            f'<div class="text-xs text-zinc-600 shrink-0">{html.escape(m["totals"]["source"])}</div></div>'
            f'<div class="flex gap-4 mt-3 text-sm tabular-nums">'
            f'<span class="text-emerald-400">{t[DONE]}</span>'
            f'<span class="text-amber-400">{t[ACTIVE]}</span>'
            f'<span class="text-zinc-500">{t[TODO]}</span></div>'
            f'<div class="h-1.5 bg-zinc-800 rounded-full mt-3 overflow-hidden">'
            f'<div class="h-full rounded-full {"bg-emerald-500" if pct == 100 else "bg-amber-500"}" style="width:{pct}%"></div>'
            f'</div></div>'
        )
    active = "".join(
        f'<tr class="border-b border-zinc-800/60"><td class="py-2 pr-4 text-zinc-500">{html.escape(m["project"])}</td>'
        f'<td class="py-2 pr-4 font-mono text-xs text-zinc-400">{html.escape(str(u["id"]))}</td>'
        f'<td class="py-2 text-zinc-200">{html.escape(u["title"])}</td></tr>'
        for m in pf["projects"]
        for u in m["board"] if u["state"] == ACTIVE
    ) or '<tr><td class="py-2 text-zinc-600 italic" colspan="3">nothing in progress</td></tr>'

    return f"""<!DOCTYPE html>
<html lang="en"><head><meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Portfolio status</title>
<script src="https://cdn.tailwindcss.com"></script>
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">
</head><body class="bg-zinc-950 text-zinc-200 antialiased">
<div class="max-w-6xl mx-auto px-6 py-12">
  <div class="flex items-end justify-between flex-wrap gap-4 mb-10">
    <div><div class="text-3xl font-semibold tracking-tighter">Portfolio status</div>
    <div class="text-sm text-zinc-500 mt-1">{pf['count']} projects</div></div>
    <div class="text-xs text-zinc-600 font-mono">{html.escape(pf['generated'])}</div>
  </div>
  <div class="grid grid-cols-3 gap-4 mb-6">
    <div class="bg-zinc-900 border border-zinc-800 rounded-3xl p-5"><div class="text-4xl font-semibold text-emerald-400 tabular-nums">{a[DONE]}</div><div class="text-sm text-zinc-400 mt-1">completed</div></div>
    <div class="bg-zinc-900 border border-zinc-800 rounded-3xl p-5"><div class="text-4xl font-semibold text-amber-400 tabular-nums">{a[ACTIVE]}</div><div class="text-sm text-zinc-400 mt-1">in progress</div></div>
    <div class="bg-zinc-900 border border-zinc-800 rounded-3xl p-5"><div class="text-4xl font-semibold text-zinc-400 tabular-nums">{a[TODO]}</div><div class="text-sm text-zinc-400 mt-1">todo</div></div>
  </div>
  <div class="flex h-2 rounded-full overflow-hidden mb-10 bg-zinc-800">
    <div class="bg-emerald-500" style="width:{round(100 * a[DONE] / total)}%"></div>
    <div class="bg-amber-500" style="width:{round(100 * a[ACTIVE] / total)}%"></div>
  </div>
  <div class="grid grid-cols-1 md:grid-cols-3 gap-4 mb-10">{rows}</div>
  <div class="bg-zinc-900/60 border border-zinc-800 rounded-3xl p-6">
    <div class="text-xs uppercase tracking-widest text-zinc-500 mb-3">In progress right now</div>
    <table class="w-full text-sm"><tbody>{active}</tbody></table>
  </div>
  <div class="text-xs text-zinc-700 mt-8">Generated — do not edit by hand.</div>
</div></body></html>
"""


# ----------------------------------------------------------------- actions/io

def adapter_argv(spec: dict) -> list[str]:
    """The argv for a script-backed adapter, resolved next to this script."""
    return [sys.executable, str(Path(__file__).resolve().parent / spec["script"])]


def adapter_available(root: Path, spec: dict) -> bool:
    """Whether this backend can actually be read here, without reading it."""
    if spec.get("env_any"):
        return any(os.environ.get(key) for key in spec["env_any"])
    if spec.get("file"):
        return (root / spec["file"]).exists()
    return False


def resolve_board(root: Path, cfg: dict, overrides: dict) -> tuple[str | None, dict]:
    """Pick the backend and its effective config.

    "auto" probes the known adapters in registry order and takes the first one
    this project can run. No backend is preferred over another; availability is
    the whole rule. A project that wants a specific one names it.
    """
    board = cfg.get("board", DEFAULT_CONFIG["board"])
    backend = (board.get("backend") or "auto").lower()

    def settle(name: str) -> tuple[str, dict]:
        return name, merge_board(board, BOARD_ADAPTERS.get(name, {}), overrides)

    if backend == "none":
        return None, board
    if backend == "command":
        return ("command", merge_board(board, overrides)) if board.get("command") else (None, board)
    if backend in BOARD_ADAPTERS:
        return settle(backend)
    if backend == "auto":
        for name, spec in BOARD_ADAPTERS.items():
            if adapter_available(root, spec):
                return settle(name)
        if board.get("command"):
            return "command", merge_board(board, overrides)
        return None, board
    return None, board


def read_board(root: Path, backend: str | None, board_cfg: dict) -> object:
    """Read the board through the resolved backend. A failure degrades to None.

    A command is run as argv, never through a shell.
    """
    if backend is None:
        return None
    spec = BOARD_ADAPTERS.get(backend, {})
    if spec.get("file") or (backend == "file" and board_cfg.get("file")):
        path = root / (board_cfg.get("file") or spec["file"])
        try:
            return json.loads(path.read_text())
        except Exception:
            return None
    cmd = adapter_argv(spec) if spec.get("script") else (board_cfg.get("command") or [])
    if not cmd or (not spec.get("script") and not shutil.which(cmd[0])):
        return None
    try:
        done = subprocess.run(cmd, cwd=root, capture_output=True, text=True, timeout=30)
        return json.loads(done.stdout) if done.returncode == 0 else None
    except Exception:
        return None


def read_commits(root: Path, n: int = 8) -> list[str]:
    """Recent commits, read-only. Absent git or no repo yields nothing."""
    if not shutil.which("git"):
        return []
    try:
        done = subprocess.run(["git", "log", f"-{n}", "--oneline", "--no-decorate"],
                              cwd=root, capture_output=True, text=True, timeout=20)
        return done.stdout.splitlines() if done.returncode == 0 else []
    except Exception:
        return []


def build_detail(model: dict, commits: list[str]) -> dict:
    """Assemble the deep view. Pure: everything it needs is already read."""
    return {
        **readiness(model["board"], model.get("raw_items", [])),
        "labels": label_counts(model.get("raw_items", []), model["board"]),
        "groups": open_groups(model["groups"]),
        "commits": commits,
    }


def read_project(path: Path, config_arg: str | None, generated: str) -> dict:
    """Read one project into a model. The only place actions and calculations meet."""
    cfg = load_config(path, config_arg)
    backend, board_cfg = resolve_board(path, cfg, cfg.get("board_overrides", {}))
    cfg = {**cfg, "board": board_cfg}
    return build_model(
        board_raw=read_board(path, backend, board_cfg),
        backend=backend,
        commits=read_commits(path),
        project=path.name,
        generated=generated,
        config=cfg,
    )


def main() -> int:
    ap = argparse.ArgumentParser(add_help=True, description=__doc__)
    ap.add_argument("--html", action="store_true", help="also write the HTML dashboard")
    ap.add_argument("--html-only", action="store_true", help="write HTML, print nothing")
    ap.add_argument("--markdown", action="store_true", help="print markdown instead of the terminal view")
    ap.add_argument("--detail", action="store_true",
                    help="deep view of one project: ready vs blocked, labels, unfinished workstreams")
    ap.add_argument("--out", default="docs/status-dashboard.html")
    ap.add_argument("--root", action="append", default=None,
                    help="project root; repeat for a portfolio across projects")
    ap.add_argument("--config", default=None,
                    help="tracker config (default: dashboard.config.json if present)")
    args = ap.parse_args()

    roots = [Path(r).resolve() for r in (args.root or
             [str(Path(__file__).resolve().parent.parent)])]
    generated = _datetime.datetime.now().strftime("%Y-%m-%d %H:%M")

    models, unread = [], []
    for root in roots:
        if not root.is_dir():
            unread.append((root, "no such directory"))
            continue
        try:
            models.append(read_project(root, args.config, generated))
        except Exception as exc:                      # a bad config must not kill the rest
            unread.append((root, str(exc)))

    if not models:
        for root, why in unread:
            print(f"  unread: {root} — {why}", file=sys.stderr)
        return 2

    portfolio = len(models) > 1
    pf = build_portfolio(models, generated) if portfolio else None

    if args.detail and portfolio:
        print("  --detail covers one project; pass a single --root", file=sys.stderr)
        return 2

    if args.detail:
        detail = build_detail(models[0], models[0]["commits"])
        text = (render_detail_markdown(models[0], detail) if args.markdown
                else render_detail_terminal(models[0], detail))
    elif args.markdown:
        text = render_portfolio_markdown(pf) if portfolio else render_markdown(models[0])
    else:
        text = ("\n".join(render_terminal(m) for m in models)
                if portfolio else render_terminal(models[0]))

    if args.html or args.html_only:
        out = Path(args.out)
        if not out.is_absolute():
            out = roots[0] / out
        out.parent.mkdir(parents=True, exist_ok=True)
        out.write_text(render_portfolio_html(pf) if portfolio else render_html(models[0]))
        if not args.html_only:
            print(text)
        try:
            shown = out.relative_to(roots[0])
        except ValueError:
            shown = out
        print(f"  → dashboard written to {shown}\n")
    else:
        print(text)

    # Unread projects are reported, never silently dropped.
    for root, why in unread:
        print(f"  unread: {root} — {why}", file=sys.stderr)
    return 0


if __name__ == "__main__":
    sys.exit(main())
