#!/usr/bin/env bash
# harness-bootstrap
# Install the CrossR harness into a project.
#
# Usage:
#   ./scripts/harness-bootstrap [target-dir]
#   ./scripts/harness-bootstrap --process-only [target-dir]
#
# Reads lockfile.toml (target, else this repo's lockfile.toml.example):
#   skills = "<tag>"
#   loops  = "<tag>"
#
# Full install copies:
#   skills pin  → .agents/skills/
#   loops pin   → .agents/skills/ (overlay) + .agents/agents/ + /avril /axel
#   this repo   → dashboard-prompt, chief-of-staff, /status, HARNESS-SPEC,
#                 status-dashboard
# Never overwrites existing .opencode/. No git submodules.
#
# --process-only: AGENTS.md, features.json, progress.md, justfile, lockfile.toml
# only. Product-repo dogfood. Does not copy skills.
#
# Overrides: CROSSR_SKILLS_PATH, CROSSR_LOOPS_PATH (skip clone).

set -euo pipefail

ROOT="$(cd "$(dirname "$0")/.." && pwd)"
SKILLS_URL="${CROSSR_SKILLS_URL:-https://github.com/sycamore-hq/crossr-skills.git}"
LOOPS_URL="${CROSSR_LOOPS_URL:-https://github.com/sycamore-hq/crossr-loops.git}"

PROCESS_ONLY=false
TARGET=""
usage() {
    sed -n '2,24p' "$0"
}

while [ $# -gt 0 ]; do
    case "$1" in
        --process-only) PROCESS_ONLY=true; shift ;;
        -h|--help)      usage; exit 0 ;;
        --force)        echo "unknown flag: --force (never overwrites .opencode/; existing AGENTS/features/progress/justfile are kept)" >&2; exit 2 ;;
        -*)             echo "unknown flag: $1" >&2; exit 2 ;;
        *)              TARGET="$1"; shift ;;
    esac
done

TARGET="${TARGET:-.}"
mkdir -p "$TARGET"
TARGET="$(cd "$TARGET" && pwd)"

echo "→ Bootstrapping harness in: $TARGET"
$PROCESS_ONLY && echo "  (process-only: tracking files, no skill copy)"

lockfile_get() {
    python3 - "$1" "$2" <<'PY'
import re, sys
path, key = sys.argv[1], sys.argv[2]
text = open(path).read()
m = re.search(r'(?m)^\s*' + re.escape(key) + r'\s*=\s*"([^"]+)"', text)
if not m:
    sys.exit(1)
print(m.group(1))
PY
}

LOCK_SRC=""
if [ -f "$TARGET/lockfile.toml" ]; then
    LOCK_SRC="$TARGET/lockfile.toml"
elif [ -f "$ROOT/lockfile.toml" ]; then
    LOCK_SRC="$ROOT/lockfile.toml"
elif [ -f "$ROOT/lockfile.toml.example" ]; then
    LOCK_SRC="$ROOT/lockfile.toml.example"
fi

SKILLS_TAG=""
LOOPS_TAG=""
if [ -n "$LOCK_SRC" ]; then
    SKILLS_TAG="$(lockfile_get "$LOCK_SRC" skills || true)"
    LOOPS_TAG="$(lockfile_get "$LOCK_SRC" loops || true)"
fi
if [ -z "$SKILLS_TAG" ] || [ -z "$LOOPS_TAG" ]; then
    echo "Error: lockfile missing skills/loops tags (looked at target, $ROOT/lockfile.toml, lockfile.toml.example)" >&2
    exit 1
fi

PIN_DIRS=()
cleanup() { rm -rf "${PIN_DIRS[@]+"${PIN_DIRS[@]}"}"; }
trap cleanup EXIT

fetch_pin() {
    local url="$1" tag="$2"
    local dest
    dest="$(mktemp -d "${TMPDIR:-/tmp}/crossr-pin.XXXXXX")"
    PIN_DIRS+=("$dest")
    echo "  → clone $url @ $tag" >&2
    git -c advice.detachedHead=false clone --quiet --depth 1 --branch "$tag" "$url" "$dest"
    echo "$dest"
}

resolve_tree() {
    local override="$1" url="$2" tag="$3"
    if [ -n "$override" ]; then
        echo "$override"
        return
    fi
    fetch_pin "$url" "$tag"
}

copy_skill_dirs() {
    local src="$1"
    [ -d "$src/.agents/skills" ] || return 0
    mkdir -p "$TARGET/.agents/skills"
    local d name
    for d in "$src"/.agents/skills/*/; do
        [ -f "$d/SKILL.md" ] || continue
        name="$(basename "$d")"
        src_real="$(cd "$d" && pwd)"
        dst_real="$TARGET/.agents/skills/$name"
        if [ -d "$dst_real" ] && [ "$src_real" = "$(cd "$dst_real" && pwd)" ]; then
            echo "  = skip self $name"
            continue
        fi
        rm -rf "$dst_real"
        cp -R "$d" "$TARGET/.agents/skills/$name"
        echo "  + skill $name"
    done
}

copy_agents() {
    local src="$1"
    [ -d "$src/.agents/agents" ] || return 0
    mkdir -p "$TARGET/.agents/agents"
    local f base
    for f in "$src/.agents/agents"/*.md; do
        [ -f "$f" ] || continue
        base="$(basename "$f")"
        if [ -f "$TARGET/.agents/agents/$base" ]; then
            echo "  = kept existing .agents/agents/$base"
        else
            cp "$f" "$TARGET/.agents/agents/$base"
            echo "  + agent $base"
        fi
    done
}

copy_opencode() {
    local src="$1"
    [ -d "$src" ] || return 0
    mkdir -p "$TARGET/.opencode/agent" "$TARGET/.opencode/command"
    local rel dest
    for rel in $( (cd "$src" && find . -type f) | sed 's|^\./||' | sort ); do
        [ -f "$src/$rel" ] || continue
        dest="$TARGET/.opencode/$rel"
        mkdir -p "$(dirname "$dest")"
        if [ -f "$dest" ]; then
            echo "  = kept existing .opencode/$rel"
        else
            cp "$src/$rel" "$dest"
            echo "  + opencode $rel"
        fi
    done
}

# 1. Process files (always)
if [ ! -f "$TARGET/AGENTS.md" ]; then
    if [ -f "$ROOT/templates/harness/AGENTS.md.template" ]; then
        cp "$ROOT/templates/harness/AGENTS.md.template" "$TARGET/AGENTS.md"
    else
        cat > "$TARGET/AGENTS.md" << 'EOF'
## Plan Mode

- Make every plan extremely concise. Sacrifice grammar for scannability.
- At the end of each plan, give a bulleted list of unresolved questions.
- Always follow the Plan → Execute → Test → Commit loop.

See [HARNESS-SPEC.md](https://github.com/sycamore-hq/crossr-harness/blob/main/HARNESS-SPEC.md) for the full process.
EOF
    fi
    echo "  + Created AGENTS.md"
else
    echo "  = Kept existing AGENTS.md"
fi

if [ ! -f "$TARGET/features.json" ]; then
    if [ -f "$ROOT/templates/harness/features.json.template" ]; then
        cp "$ROOT/templates/harness/features.json.template" "$TARGET/features.json"
    else
        printf '%s\n' '{ "phase0": { "status": "in_progress", "commits": [] } }' > "$TARGET/features.json"
    fi
    echo "  + Created features.json"
else
    echo "  = Kept existing features.json"
fi

if [ ! -f "$TARGET/progress.md" ]; then
    cat > "$TARGET/progress.md" << 'EOF'
# Implementation Progress

## Verification Status
- Tooling: pending
- Reviews: pending
EOF
    echo "  + Created progress.md stub"
else
    echo "  = Kept existing progress.md"
fi

if [ ! -f "$TARGET/justfile" ]; then
    cat > "$TARGET/justfile" << 'EOF'
default:
    @just --list

init:
    echo "environment ready"

check:
    cargo check --workspace 2>/dev/null || echo "(no Rust crates)"

test:
    cargo test --workspace 2>/dev/null || echo "(no tests)"
EOF
    echo "  + Created justfile"
else
    echo "  = Kept existing justfile"
fi

if [ ! -f "$TARGET/lockfile.toml" ]; then
    cat > "$TARGET/lockfile.toml" << EOF
# Pins consumed by harness-bootstrap / sync-skills.
# Not a third tracker — features.json remains the work log. No git submodules.
skills = "${SKILLS_TAG}"
loops  = "${LOOPS_TAG}"
EOF
    echo "  + Created lockfile.toml (skills=${SKILLS_TAG} loops=${LOOPS_TAG})"
else
    echo "  = Kept existing lockfile.toml"
fi

if $PROCESS_ONLY; then
    echo ""
    echo "✓ Process-only harness in $TARGET"
    echo "  Pins: skills=${SKILLS_TAG} loops=${LOOPS_TAG}"
    exit 0
fi

# 2. Pins
SKILLS_TREE="$(resolve_tree "${CROSSR_SKILLS_PATH:-}" "$SKILLS_URL" "$SKILLS_TAG")"
LOOPS_TREE="$(resolve_tree "${CROSSR_LOOPS_PATH:-}" "$LOOPS_URL" "$LOOPS_TAG")"

echo "  skills tree: $SKILLS_TREE"
echo "  loops tree:  $LOOPS_TREE"

copy_skill_dirs "$SKILLS_TREE"
copy_skill_dirs "$LOOPS_TREE"
copy_skill_dirs "$ROOT"
copy_agents "$SKILLS_TREE"
copy_agents "$LOOPS_TREE"

copy_opencode "$ROOT/templates/harness/opencode"
copy_opencode "$LOOPS_TREE/templates/harness/opencode"

if [ ! -f "$TARGET/HARNESS-SPEC.md" ] && [ -f "$ROOT/HARNESS-SPEC.md" ]; then
    cp "$ROOT/HARNESS-SPEC.md" "$TARGET/HARNESS-SPEC.md"
    echo "  + HARNESS-SPEC.md"
fi

if [ -f "$ROOT/scripts/status-dashboard" ]; then
    mkdir -p "$TARGET/scripts"
    if [ ! -f "$TARGET/scripts/status-dashboard" ]; then
        cp "$ROOT/scripts/status-dashboard" "$TARGET/scripts/status-dashboard"
        chmod +x "$TARGET/scripts/status-dashboard"
        echo "  + scripts/status-dashboard"
    else
        echo "  = kept existing scripts/status-dashboard"
    fi
    if [ -f "$TARGET/justfile" ] && ! grep -qE '^status:' "$TARGET/justfile"; then
        printf '\n# Orchestration status dashboard (in-harness UI)\nstatus:\n    @./scripts/status-dashboard\n\nstatus-html:\n    @./scripts/status-dashboard --html\n' >> "$TARGET/justfile"
        echo "  + justfile status / status-html"
    fi
fi

echo ""
echo "✓ Harness installed in $TARGET"
echo "  Pins: skills=${SKILLS_TAG} loops=${LOOPS_TAG}"
echo "  Next: commit the scaffold, restart opencode, /avril /axel /status"
echo "  Never overwrote existing .opencode/."
