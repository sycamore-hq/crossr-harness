# Pins consumed by harness-bootstrap / sync-skills.
# Pins, not work state — the board remains the work log. No git submodules.
# skills = catalog at the board cutover (no tracking files, no named board).
# loops  = v1-board-consumers (board-agnostic loop law).
# books  = disclosed language books. Disclosure filter, not a copy filter:
#          bootstrap copies every skill directory that has a SKILL.md.

skills = "v1-board"
loops  = "v1-board-consumers"
books  = ["rust"]     # disclosed language books; ["ocaml"], ["rust", "ts"], ...
